# Copy this file to deployment/.env on the VPS and set unique production values.
# Do NOT commit deployment/.env. A real DNS A/AAAA record must point here first.
SITE_DOMAIN=batchtrace.example.com
POSTGRES_DB=batchtrace_db
POSTGRES_USER=batchtrace_app
# Use URL-safe randomly generated secrets (letters, digits, hyphens, underscores).
POSTGRES_PASSWORD=
JWT_SECRET=
